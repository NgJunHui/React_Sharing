{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/sections/**/*.tsx"],
      "rules": {
        // Section content passes static JSX cells to <DataTable rows={...} />,
        // which supplies the keys itself when it maps them. The elements in
        // these literals are never reordered.
        "react/jsx-key": "off"
      }
    }
  ]
}
